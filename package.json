{
  "name": "@grafikui/motion",
  "version": "1.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omrdev1/grafikui-motion.git"
  },
  "homepage": "https://motionmanifesto.co.uk",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./marketing": {
      "types": "./build/marketing.d.ts",
      "import": "./build/marketing.js"
    },
    "./tokens/motion": {
      "types": "./build/tokens/motion.d.ts",
      "import": "./build/tokens/motion.js"
    },
    "./tokens/colours": {
      "types": "./build/tokens/colours.d.ts",
      "import": "./build/tokens/colours.js"
    },
    "./tokens/typography": {
      "types": "./build/tokens/typography.d.ts",
      "import": "./build/tokens/typography.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepare": "tsup",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "framer-motion": "^12.36.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.3.18"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
